@model WarehouseApp.Models.PaginatedList<WarehouseApp.Models.Transaction>

@{
    ViewData["Title"] = "Buchungen";
    var query = Context.Request.Query;
}

<div class="container mt-4">

    <!-- 🧾 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-arrow-left-right"></i> Buchungen
        </h2>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Buchung hinzufügen
        </a>
    </div>

    <!-- 🔍 FILTERS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <strong><i class="bi bi-funnel"></i> Filter</strong>
        </div>

        <div class="card-body">
            <form method="get" class="row g-3">

                <div class="col-md-2">
                    <label class="form-label">Typ</label>
                    <select name="type" class="form-select">
                        <option value="">Alle</option>
                        <option value="IN" selected="@(query["type"] == "IN")">Eingang</option>
                        <option value="OUT" selected="@(query["type"] == "OUT")">Ausgang</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Kategorie</label>
                    <select name="categoryId" class="form-select" asp-items="ViewBag.CategoryId">
                        <option value="">Alle</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Artikel</label>
                    <select name="productId" class="form-select" asp-items="ViewBag.ProductId">
                        <option value="">Alle</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Von</label>
                    <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Bis</label>
                    <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Bemerkung</label>
                    <input type="text" name="search" class="form-control"
                           placeholder="Suchen..." value="@query["search"]" />
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Filtern
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Zurücksetzen
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- ✅ SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
        </div>
    }

    <!-- 📋 TABLE -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Datum</th>
                        <th>Typ</th>
                        <th>Artikel</th>
                        <th>Kategorie</th>
                        <th class="text-center">Menge</th>
                        <th>Bemerkung</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isIn = item.TransactionType == "IN";
                        <tr>
                            <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>

                            <td>
                                <span class="badge @(isIn ? "bg-success" : "bg-danger")">
                                    <i class="bi @(isIn ? "bi-box-arrow-in-down" : "bi-box-arrow-up")"></i>
                                    @item.TransactionType
                                </span>
                            </td>

                            <td>@item.Product?.Name</td>
                            <td>@item.Product?.Category?.Name</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-muted">@item.Comment</td>
                            <td class="text-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.TransactionId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.TransactionId"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 🔄 PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-all-route-data="Context.Request.Query.ToDictionary(k => k.Key, v => v.Value.ToString())">
                        Zurück
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@i"
                           asp-all-route-data="Context.Request.Query.ToDictionary(k => k.Key, v => v.Value.ToString())">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-all-route-data="Context.Request.Query.ToDictionary(k => k.Key, v => v.Value.ToString())">
                        Weiter
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>

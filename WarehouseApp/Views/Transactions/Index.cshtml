@model WarehouseApp.Models.PaginatedList<WarehouseApp.Models.Transaction>
@{
    ViewData["Title"] = "Transactions";
    var query = Context.Request.Query;
    var pageNumber = Model.PageIndex;
    var totalPages = Model.TotalPages;
}

<h2 class="mb-3">Transactions</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-2">
        <select name="type" class="form-select">
            <option value="">All Types</option>
            <option value="IN" selected="@(query["type"] == "IN")">IN</option>
            <option value="OUT" selected="@(query["type"] == "OUT")">OUT</option>
        </select>
    </div>

    <div class="col-md-2">
        <select name="categoryId" class="form-select" asp-items="ViewBag.CategoryId">
            <option value="">All Categories</option>
        </select>
    </div>

    <div class="col-md-2">
        <select name="productId" class="form-select" asp-items="ViewBag.ProductId">
            <option value="">All Products</option>
        </select>
    </div>

    <div class="col-md-2">
        <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
    </div>

    <div class="col-md-2">
        <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
    </div>

    <div class="col-md-2">
        <input type="text" name="search" class="form-control" placeholder="Search comment..." value="@query["search"]" />
    </div>

    <div class="col-md-12 mt-2 d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Add Transaction</a>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Product</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Comment</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var color = item.TransactionType == "IN" ? "text-success" : "text-danger";
            var icon = item.TransactionType == "IN" ? "bi-box-arrow-in-down" : "bi-box-arrow-up";
            <tr>
                <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="@color fw-bold">
                    <i class="bi @icon"></i> @item.TransactionType
                </td>
                <td>@item.Product?.Name</td>
                <td>@item.Product?.Category?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.Comment</td>
            </tr>
        }
    </tbody>
</table>

<!-- 🔄 Pagination -->
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@(pageNumber - 1)"
                   asp-all-route-data="Context.Request.Query.ToDictionary(k => k.Key, v => v.Value.ToString())">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-all-route-data="Context.Request.Query.ToDictionary(k => k.Key, v => v.Value.ToString())">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@(pageNumber + 1)"
                   asp-all-route-data="Context.Request.Query.ToDictionary(k => k.Key, v => v.Value.ToString())">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}

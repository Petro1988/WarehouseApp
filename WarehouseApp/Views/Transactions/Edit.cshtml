@model WarehouseApp.Models.Transaction

@{
    ViewData["Title"] = "Buchung bearbeiten";
}

<div class="container mt-4">
    <h2><i class="bi bi-pencil-square"></i> Buchung bearbeiten</h2>

    <form asp-action="Edit" method="post" class="card shadow-sm p-4">
        <input type="hidden" asp-for="TransactionId" />

        <div class="mb-3">
            <label class="form-label">Produkt</label>
            <select asp-for="ProductId"
                    class="form-select"
                    asp-items="ViewBag.ProductId">
            </select>
            <span asp-validation-for="ProductId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Typ</label>
            <select asp-for="TransactionType" class="form-select">
                <option value="IN">Eingang</option>
                <option value="OUT">Ausgang</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Menge</label>
            <input asp-for="Quantity"
                   type="number"
                   min="1"
                   class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Bemerkung</label>
            <textarea asp-for="Comment" class="form-control"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Speichern
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Abbrechen
            </a>
        </div>
    </form>
</div>

@{
    ViewData["Title"] = "Dashboard";
    var transactions = ViewBag.Transactions as List<WarehouseApp.Models.Transaction>;
    var categories = ViewBag.Categories as List<WarehouseApp.Models.Category>;
}

<h2>📦 Warehouse Dashboard</h2>

<!-- 🔍 ФОРМА ФІЛЬТРА -->
<form id="filterForm" method="get" class="row g-3 mt-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">From date:</label>
        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">To date:</label>
        <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Type:</label>
        <select name="type" class="form-select">
            <option value="">All</option>
            <option value="IN" selected="@(ViewBag.SelectedType == "IN")">Incoming</option>
            <option value="OUT" selected="@(ViewBag.SelectedType == "OUT")">Outgoing</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Category:</label>
        <select name="categoryId" class="form-select">
            <option value="0">All</option>
            @foreach (var c in categories)
            {
                <option value="@c.CategoryId" selected="@(ViewBag.SelectedCategory == c.CategoryId)">@c.Name</option>
            }
        </select>
    </div>

    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>

    <div class="col-md-1 d-flex align-items-end">
        <button type="button" id="resetBtn" class="btn btn-secondary w-100">Reset</button>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="exportBtn" class="btn btn-success w-100">Export to Excel</button>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="exportPdfBtn" class="btn btn-danger w-100">
            Export PDF (with chart)
        </button>
    </div>

</form>

<!-- 📊 ГРАФІК 1 -->
<div class="card p-3 mb-4 shadow-sm">
    <h4>📈 Transactions Summary</h4>
    <canvas id="transactionsChart" height="100"></canvas>
</div>

<!-- 📊 ГРАФІК 2 -->
<div class="card p-3 mb-4 shadow-sm">
    <h4>🥧 Activity by Category</h4>
    <canvas id="categoryChart" height="100"></canvas>
</div>

<!-- 📋 ТАБЛИЦЯ -->
<div id="results">
    @await Html.PartialAsync("_TransactionTable", (IEnumerable<WarehouseApp.Models.Transaction>)ViewBag.Transactions)
</div>

<!-- ✅ JAVASCRIPT -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let chart;
    let categoryChart;

    // 📅 Фільтр
    document.getElementById("filterForm").addEventListener("submit", async function (e) {
        e.preventDefault();
        const form = e.target;
        const params = new URLSearchParams(new FormData(form));

        const response = await fetch(`/Dashboard/Filter?${params.toString()}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const html = await response.text();
        document.getElementById("results").innerHTML = html;

        await updateChart(params.toString());
        await updateCategoryChart(params.toString());
    });

    // 🔁 Reset
    document.getElementById("resetBtn").addEventListener("click", async function () {
        document.getElementById("filterForm").reset();
        const response = await fetch(`/Dashboard/Filter`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const html = await response.text();
        document.getElementById("results").innerHTML = html;

        await updateChart('');
        await updateCategoryChart('');
    });

    // 📊 Графік 1 — транзакції
    async function updateChart(params = '') {
        const response = await fetch(`/Dashboard/GetChartData?${params}`);
        const data = await response.json();
        const ctx = document.getElementById('transactionsChart').getContext('2d');
        if (chart) chart.destroy();

        chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: data.labels,
                datasets: [
                    {
                        label: 'Incoming',
                        data: data.incoming,
                        borderColor: 'green',
                        fill: false,
                        tension: 0.3
                    },
                    {
                        label: 'Outgoing',
                        data: data.outgoing,
                        borderColor: 'red',
                        fill: false,
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } },
                scales: { y: { beginAtZero: true } }
            }
        });
    }

    // 🥧 Графік 2 — по категоріях
    async function updateCategoryChart(params = '') {
        const response = await fetch(`/Dashboard/GetCategoryChartData?${params}`);
        const data = await response.json();
        const ctx = document.getElementById('categoryChart').getContext('2d');
        if (categoryChart) categoryChart.destroy();

        categoryChart = new Chart(ctx, {
            type: 'pie',
            data: {
                labels: data.labels,
                datasets: [{
                    data: data.values,
                    backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    }

    // 💾 Export to Excel
    document.getElementById("exportBtn").addEventListener("click", function () {
        const form = document.getElementById("filterForm");
        const params = new URLSearchParams(new FormData(form));
        window.location.href = `/Dashboard/ExportToExcel?${params.toString()}`;
    });

        // 🧾 Export to PDF
        document.getElementById("exportPdfBtn").addEventListener("click", async function () {
        const form = document.getElementById("filterForm");
        const params = new URLSearchParams(new FormData(form));

        // Отримуємо зображення з графіка Chart.js
        const chartCanvas = document.getElementById('transactionsChart');
        const chartImage = chartCanvas.toDataURL('image/png');

        // Відправляємо POST на сервер
        const response = await fetch('/Dashboard/ExportToPdf', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                chartBase64: chartImage,
                fromDate: form.fromDate.value,
                toDate: form.toDate.value,
                type: form.type.value,
                categoryId: form.categoryId.value
            })
        });

        // Отримуємо PDF
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Warehouse_Report.pdf';
        a.click();
        window.URL.revokeObjectURL(url);
    });


    // 🧠 Ініціалізація графіків при завантаженні сторінки
    updateChart();
    updateCategoryChart();
</script>

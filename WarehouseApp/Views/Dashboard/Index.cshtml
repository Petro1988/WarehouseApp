@{
    ViewData["Title"] = "Dashboard";
    var transactions = ViewBag.Transactions as List<WarehouseApp.Models.Transaction>;
    var categories = ViewBag.Categories as List<WarehouseApp.Models.Category>;
}

<div class="container-fluid mt-4">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-speedometer2"></i> SVG-IT Lagerübersicht
        </h2>
    </div>

    <!-- 🔍 FILTER CARD -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-funnel"></i> Filter
        </div>

        <div class="card-body">
            <form id="filterForm" method="get" class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">Von Datum</label>
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Bis Datum</label>
                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Typ</label>
                    <select name="type" class="form-select">
                        <option value="">Alle</option>
                        <option value="IN" selected="@(ViewBag.SelectedType == "IN")">Wareneingang</option>
                        <option value="OUT" selected="@(ViewBag.SelectedType == "OUT")">Warenausgang</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Kategorie</label>
                    <select name="categoryId" class="form-select">
                        <option value="0">Alle</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.CategoryId"
                                    selected="@(ViewBag.SelectedCategory == c.CategoryId)">
                                @c.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                    </button>
                    <button type="button" id="resetBtn" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="button" id="exportBtn" class="btn btn-success w-100">
                        <i class="bi bi-file-earmark-excel"></i> Excel
                    </button>
                </div>

            </form>
        </div>
    </div>

    <!-- 📊 CHARTS -->
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <i class="bi bi-graph-up"></i> Bewegungen im Zeitverlauf
                </div>
                <div class="card-body">
                    <canvas id="transactionsChart" height="120"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <i class="bi bi-pie-chart"></i> Aktivität nach Kategorie
                </div>
                <div class="card-body">
                    <canvas id="categoryChart" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 📋 TABLE -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-list-ul"></i> Buchungen
        </div>
        <div class="card-body p-0" id="results">
            @await Html.PartialAsync("_TransactionTable",
            (IEnumerable<WarehouseApp.Models.Transaction>)ViewBag.Transactions)
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@section Scripts {
    <script>
        let transactionsChart;
        let categoryChart;

        async function loadCharts() {
            const params = new URLSearchParams(new FormData(document.getElementById("filterForm")));

            // 📈 Transactions Over Time
            const timeRes = await fetch('/Dashboard/GetChartData?' + params);
            const timeData = await timeRes.json();

            const ctx1 = document.getElementById('transactionsChart').getContext('2d');
            if (transactionsChart) transactionsChart.destroy();

            transactionsChart = new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: timeData.labels,
                    datasets: [
                        {
                            label: 'Incoming',
                            data: timeData.incoming,
                            borderWidth: 2
                        },
                        {
                            label: 'Outgoing',
                            data: timeData.outgoing,
                            borderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });

            // 🍩 Activity by Category
            const catRes = await fetch('/Dashboard/GetCategoryChartData?' + params);
            const catData = await catRes.json();

            const ctx2 = document.getElementById('categoryChart').getContext('2d');
            if (categoryChart) categoryChart.destroy();

            categoryChart = new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: catData.labels,
                    datasets: [{
                        data: catData.values
                    }]
                },
                options: {
                    responsive: true
                }
            });
        }

        // 🔄 initial load
        document.addEventListener('DOMContentLoaded', loadCharts);

        // 🔍 reload on filter submit
        document.getElementById("filterForm").addEventListener("submit", function () {
            setTimeout(loadCharts, 100);
        });

        // 🔁 reset
        document.getElementById("resetBtn").addEventListener("click", function () {
            window.location = '/Dashboard';
        });
    </script>
}

<script>
    document.getElementById("exportBtn").addEventListener("click", function () {
        const params = new URLSearchParams(new FormData(document.getElementById("filterForm")));
        window.location = '/Dashboard/ExportToExcel?' + params.toString();
    });
</script>


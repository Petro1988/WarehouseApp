@model IEnumerable<WarehouseApp.Models.Transaction>

<table class="table table-striped table-hover mb-0 align-middle">
    <thead class="table-light">
        <tr>
            <th>Datum</th>
            <th>Artikel</th>
            <th>Kategorie</th>
            <th class="text-end">Menge</th>
            <th class="text-center">Art</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var t in Model)
            {
                <tr>
                    <td>@t.Date.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@t.Product?.Name</td>
                    <td>@t.Product?.Category?.Name</td>
                    <td class="text-end">@t.Quantity</td>
                    <td class="text-center">
                        <span class="badge @(t.TransactionType == "IN" ? "bg-success" : "bg-danger")">
                            @t.TransactionType
                        </span>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    <i class="bi bi-info-circle"></i> Keine Buchungen gefunden
                </td>
            </tr>
        }
    </tbody>
</table>

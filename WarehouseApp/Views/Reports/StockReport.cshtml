@model IEnumerable<WarehouseApp.Models.Product>

<h4 class="mb-3">@ViewBag.PeriodText</h4>

<form method="get" class="card shadow-sm p-3 mb-4">
    <div class="row g-3 align-items-end">

        <div class="col-md-2">
            <label class="form-label">Datum</label>
            <input type="date"
                   name="date"
                   class="form-control"
                   value="@ViewBag.Date" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Kategorie</label>
            <select name="categoryId" class="form-select">
                <option value="">Alle Kategorien</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat.CategoryId"
                            selected="@(ViewBag.SelectedCategory == cat.CategoryId)">
                        @cat.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Artikel</label>
            <select name="productId" class="form-select">
                <option value="">Alle Artikel</option>
                @foreach (var p in ViewBag.Products)
                {
                    <option value="@p.ProductId"
                            selected="@(ViewBag.SelectedProduct == p.ProductId)">
                        @p.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <div class="form-check mt-4">
                <input class="form-check-input"
                       type="checkbox"
                       name="onlyBelowMin"
                       value="true"
                       @(ViewBag.OnlyBelowMin == true ? "checked" : "") />
                <label class="form-check-label">
                    Unter Mindestbestand
                </label>
            </div>
        </div>


        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel"></i> Anwenden
            </button>
        </div>

        <div class="col-md-2">
            <a asp-action="StockReport" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-circle"></i> Zurücksetzen
            </a>
        </div>

        <div class="col-md-12">
            <button name="export" value="true" class="btn btn-success w-100">
                <i class="bi bi-file-earmark-excel"></i> Nach Excel exportieren (immer aktueller Bestand)
            </button>
        </div>
    </div>
</form>

@if (ViewBag.PeriodText != null)
{
    <div class="alert alert-info">
        <i class="bi bi-calendar-event"></i>
        @ViewBag.PeriodText
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Artikel</th>
                    <th>Kategorie</th>
                    <th class="text-center">Menge</th>
                    <th class="text-center">Mindestbestand</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var p in Model)
                    {
                        bool isLow = p.MinimumStock > 0 && p.Quantity < p.MinimumStock;
                        <tr class="@(isLow ? "table-warning" : "")">
                            <td>@p.Name</td>
                            <td>@p.Category?.Name</td>
                            <td class="text-center fw-bold">
                                @(p.Quantity > 0 ? p.Quantity : 0)
                            </td>
                            <td class="text-center">
                                @(p.MinimumStock == 0 ? "—" : p.MinimumStock)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            Keine Lagerdaten vorhanden
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



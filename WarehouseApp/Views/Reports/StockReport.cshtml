@model IEnumerable<WarehouseApp.Models.Transaction>
@{
    ViewData["Title"] = "Stock Report";
}

<h2 class="mb-4">Stock Report</h2>

<form method="get" class="row g-2 mb-3">

    <!-- DATE -->
    <div class="col-md-2">
        <input type="date" name="date" class="form-control" value="@ViewBag.Date" />
    </div>

    <!-- CATEGORY -->
    <div class="col-md-3">
        <select name="categoryId" class="form-select">
            <option value="">All Categories</option>

            @foreach (var cat in ViewBag.Categories)
            {
                if (ViewBag.SelectedCategory != null && ViewBag.SelectedCategory == cat.CategoryId)
                {
                    <option value="@cat.CategoryId" selected>@cat.Name</option>
                }
                else
                {
                    <option value="@cat.CategoryId">@cat.Name</option>
                }
            }
        </select>
    </div>

    <!-- PRODUCT -->
    <div class="col-md-3">
        <select name="productId" class="form-select">
            <option value="">All Products</option>

            @foreach (var p in ViewBag.Products)
            {
                if (ViewBag.SelectedProduct != null && ViewBag.SelectedProduct == p.ProductId)
                {
                    <option value="@p.ProductId" selected>@p.Name</option>
                }
                else
                {
                    <option value="@p.ProductId">@p.Name</option>
                }
            }
        </select>
    </div>

    <!-- SEARCH -->
    <div class="col-md-2">
        <input type="text" name="search" class="form-control" placeholder="Search comment..." value="@ViewBag.Search" />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Apply</button>
    </div>

    <div class="col-md-12 mt-2">
        <button name="export" value="true" class="btn btn-success w-100">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </button>
    </div>

</form>


<table class="table table-striped table-hover">
    <thead class="table-light">
        <tr>
            <th>Date</th>
            <th>Product</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Comment</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Date.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@t.Product?.Name</td>
                <td>@t.Product?.Category?.Name</td>
                <td>@t.Quantity</td>
                <td>@t.Comment</td>
            </tr>
        }
    </tbody>
</table>

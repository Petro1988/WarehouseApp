@model IEnumerable<WarehouseApp.Models.Transaction>

<!-- FILTERS -->
<form method="get" class="card shadow-sm p-3 mb-4">
    <div class="row g-3 align-items-end">

        <div class="col-md-2">
            <label class="form-label">Von</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Bis</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Kategorie</label>
            <select name="categoryId" class="form-select">
                <option value="">Alle Kategorien</option>
                @foreach (var c in ViewBag.Categories)
                {
                    <option value="@c.CategoryId"
                            selected="@(ViewBag.SelectedCategory == c.CategoryId)">
                        @c.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Artikel</label>
            <select name="productId" class="form-select">
                <option value="">Alle Artikel</option>
                @foreach (var p in ViewBag.Products)
                {
                    <option value="@p.ProductId"
                            selected="@(ViewBag.SelectedProduct == p.ProductId)">
                        @p.Name
                    </option>
                }
            </select>
        </div>

        <!-- Search -->
        <div class="col-md-2">
            <label class="form-label">Bemerkung</label>
            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Bemerkung suchen..."
                   value="@ViewBag.Search" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel"></i> Anwenden
            </button>
        </div>

        <!-- Clear -->
        @if (!string.IsNullOrWhiteSpace(ViewBag.From) ||
                !string.IsNullOrWhiteSpace(ViewBag.To) ||
                ViewBag.SelectedCategory != null ||
                ViewBag.SelectedProduct != null ||
                !string.IsNullOrWhiteSpace(ViewBag.Search))
        {
            <div class="col-md-2">
                <a asp-action="IncomingReport"
                   class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> Zurücksetzen
                </a>
            </div>
        }

        <div class="col-md-12">
            <button name="export" value="true" class="btn btn-success w-100">
                <i class="bi bi-file-earmark-excel"></i>
                Nach Excel exportieren
            </button>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(ViewBag.PeriodText))
{
    <div class="alert alert-info">
        <i class="bi bi-calendar-event"></i>
        @ViewBag.PeriodText
    </div>
}

<!-- 📋 TABLE -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Datum</th>
                    <th>Artikel</th>
                    <th>Kategorie</th>
                    <th class="text-center">Menge</th>
                    <th>Bemerkung</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@t.Product?.Name</td>
                            <td>@t.Product?.Category?.Name</td>
                            <td class="text-center fw-bold text-success">
                                <i class="bi bi-box-arrow-in-down"></i> @t.Quantity
                            </td>
                            <td>@t.Comment</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-info-circle"></i>
                            Keine Wareneingänge gefunden
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


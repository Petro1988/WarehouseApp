@model IEnumerable<WarehouseApp.Models.Transaction>
@{
    ViewData["Title"] = "Outgoing Report";
}

<h2 class="mb-4">Outgoing Report</h2>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-2">
        <label class="form-label">From Date</label>
        <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
    </div>
    <div class="col-md-2">
        <label class="form-label">To Date</label>
        <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Category</label>
        <select name="categoryId" class="form-select">
            <option value="">All Categories</option>
            @foreach (var cat in ViewBag.Categories)
            {
                if (ViewBag.SelectedCategory != null && ViewBag.SelectedCategory == cat.CategoryId)
                {
                    <option value="@cat.CategoryId" selected>@cat.Name</option>
                }
                else
                {
                    <option value="@cat.CategoryId">@cat.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Product</label>
        <select name="productId" class="form-select">
            <option value="">All Products</option>
            @foreach (var prod in ViewBag.Products)
            {
                if (ViewBag.SelectedProduct != null && ViewBag.SelectedProduct == prod.ProductId)
                {
                    <option value="@prod.ProductId" selected>@prod.Name</option>
                }
                else
                {
                    <option value="@prod.ProductId">@prod.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Comment Search</label>
        <input type="text" name="search" class="form-control" value="@ViewBag.Search" placeholder="Search..." />
    </div>
    <div class="col-md-1 align-self-end">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<form method="get">
    <input type="hidden" name="fromDate" value="@ViewBag.FromDate" />
    <input type="hidden" name="toDate" value="@ViewBag.ToDate" />
    <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategory" />
    <input type="hidden" name="productId" value="@ViewBag.SelectedProduct" />
    <input type="hidden" name="search" value="@ViewBag.Search" />
    <input type="hidden" name="export" value="true" />
    <button type="submit" class="btn btn-danger mb-3">
        <i class="bi bi-file-earmark-excel"></i> Export to Excel
    </button>
</form>

<table class="table table-striped table-hover">
    <thead class="table-light">
        <tr>
            <th>Date</th>
            <th>Product</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Comment</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Date.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@t.Product?.Name</td>
                <td>@t.Product?.Category?.Name</td>
                <td>@t.Quantity</td>
                <td>@t.Comment</td>
            </tr>
        }
    </tbody>
</table>

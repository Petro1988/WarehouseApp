@model IEnumerable<WarehouseApp.Models.Transaction>

<!-- FILTERS -->
<form method="get" class="card shadow-sm p-3 mb-4">
    <div class="row g-3 align-items-end">

        <!-- From -->
        <div class="col-md-2">
            <label class="form-label">Von</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>

        <!-- To -->
        <div class="col-md-2">
            <label class="form-label">Bis</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>

        <!-- Category -->
        <div class="col-md-3">
            <label class="form-label">Kategorie</label>
            <select name="categoryId" class="form-select">
                <option value="">Alle Kategorien</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat.CategoryId"
                            selected="@(ViewBag.SelectedCategory == cat.CategoryId)">
                        @cat.Name
                    </option>
                }
            </select>
        </div>

        <!-- Product -->
        <div class="col-md-3">
            <label class="form-label">Artikel</label>
            <select name="productId" class="form-select">
                <option value="">Alle Artikel</option>
                @foreach (var prod in ViewBag.Products)
                {
                    <option value="@prod.ProductId"
                            selected="@(ViewBag.SelectedProduct == prod.ProductId)">
                        @prod.Name
                    </option>
                }
            </select>
        </div>

        <!-- Search -->
        <div class="col-md-2">
            <label class="form-label">Bemerkung</label>
            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Bemerkung suchen..."
                   value="@ViewBag.Search" />
        </div>

        <!-- Apply -->
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel"></i> Anwenden
            </button>
        </div>

        <!-- Clear -->
        @if (!string.IsNullOrWhiteSpace(ViewBag.From) ||
                !string.IsNullOrWhiteSpace(ViewBag.To) ||
                ViewBag.SelectedCategory != null ||
                ViewBag.SelectedProduct != null ||
                !string.IsNullOrWhiteSpace(ViewBag.Search))
        {
            <div class="col-md-2">
                <a asp-action="OutgoingReport"
                   class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> Zurücksetzen
                </a>
            </div>
        }

        <!-- Export -->
        <div class="col-md-12">
            <button name="export"
                    value="true"
                    class="btn btn-danger w-100">
                <i class="bi bi-file-earmark-excel"></i> Nach Excel exportieren
            </button>
        </div>

    </div>
</form>

@if (!string.IsNullOrEmpty(ViewBag.PeriodText))
{
    <div class="alert alert-info">
        <i class="bi bi-calendar-event"></i>
        @ViewBag.PeriodText
    </div>
}

<!-- TABLE -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Datum</th>
                    <th>Artikel</th>
                    <th>Kategorie</th>
                    <th class="text-center">Menge</th>
                    <th>Bemerkung</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@t.Product?.Name</td>
                            <td>@t.Product?.Category?.Name</td>
                            <td class="text-center fw-bold text-danger">
                                <i class="bi bi-box-arrow-up"></i> @t.Quantity
                            </td>
                            <td>@t.Comment</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-info-circle"></i>
                            Keine Warenausgänge gefunden
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (ViewBag.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center mt-3">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="IncomingReport"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-from="@ViewBag.From"
                           asp-route-to="@ViewBag.To"
                           asp-route-categoryId="@ViewBag.SelectedCategory"
                           asp-route-productId="@ViewBag.SelectedProduct"
                           asp-route-search="@ViewBag.Search">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="?page=@i&from=@ViewBag.From&to=@ViewBag.To&categoryId=@ViewBag.SelectedCategory&productId=@ViewBag.SelectedProduct&search=@ViewBag.Search">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@model IEnumerable<WarehouseApp.Models.User>

@{
    ViewData["Title"] = "Benutzerverwaltung";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people"></i> Benutzerverwaltung
        </h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Benutzer hinzufügen
        </a>
    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 🔍 SEARCH -->
    <form method="get" class="mb-3">
        <div class="input-group shadow-sm">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Nach Benutzername suchen..." />

            <button class="btn btn-outline-primary" type="submit">
                <i class="bi bi-search"></i>
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
    {
        <div class="text-muted mb-2">
            Found @Model.Count() user(s)
        </div>
    }

    <!-- TABLE CARD -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Benutzername</th>
                        <th>Rolle</th>
                        <th class="text-end">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        bool isCurrentUser = User.Identity?.Name == user.Username;

                        <tr class="@(isCurrentUser ? "table-info" : "")">
                            <td>@user.UserId</td>

                            <td>
                                @user.Username
                                @if (isCurrentUser)
                                {
                                    <span class="badge bg-secondary ms-2">Du</span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-dark">@user.Role</span>
                            </td>

                            <td class="text-end">
                                <a asp-action="Edit"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil-square"></i> Bearbeiten
                                </a>

                                <a asp-action="ResetPassword"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-key"></i> Zurücksetzen
                                </a>

                                @if (!isCurrentUser)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Löschen
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary"
                                            disabled
                                            title="You cannot delete yourself">
                                        <i class="bi bi-lock"></i> Löschen
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

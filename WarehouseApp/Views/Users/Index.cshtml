@model IEnumerable<WarehouseApp.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-people"></i> User Management</h3>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Add User
        </a>
    </div>

    <!-- ✅ Success message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <table class="table table-striped table-hover align-middle shadow-sm bg-white rounded">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Role</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                bool isCurrentUser = User.Identity?.Name == user.Username;

                <tr class="@(isCurrentUser ? "table-info" : "")">
                    <td>@user.UserId</td>
                    <td>
                        @user.Username
                        @if (isCurrentUser)
                        {
                            <span class="badge bg-secondary ms-2">You</span>
                        }
                    </td>
                    <td>@user.Role</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>

                        <a asp-action="ResetPassword" asp-route-id="@user.UserId" class="btn btn-sm btn-warning me-1">
                            <i class="bi bi-key"></i> Reset Password
                        </a>

                        @if (!isCurrentUser)
                        {
                            <a asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="You cannot delete yourself">
                                <i class="bi bi-lock"></i> Delete
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

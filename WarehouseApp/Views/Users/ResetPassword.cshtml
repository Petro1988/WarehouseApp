@model WarehouseApp.Models.User

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-4">
    <h3>Reset Password for <strong>@Model.Username</strong></h3>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="ResetPassword" asp-route-id="@Model.UserId" method="post" class="mt-3">
        <div class="mb-3">
            <label for="newPassword" class="form-label">New Password</label>
            <input type="password" name="newPassword" id="newPassword" class="form-control" required placeholder="Enter new password" />
        </div>

        <div class="mb-3">
            <label for="confirmPassword" class="form-label">Confirm Password</label>
            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" required placeholder="Confirm new password" />
        </div>

        <div class="d-flex">
            <button type="submit" class="btn btn-success me-2">
                <i class="bi bi-check-circle"></i> Save New Password
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </form>
</div>

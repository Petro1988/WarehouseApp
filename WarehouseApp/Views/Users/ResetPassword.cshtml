@model WarehouseApp.Models.User

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <i class="bi bi-key"></i> Passwort zurücksetzen
        </div>

        <div class="card-body">
            <p class="mb-3">
                Passwort zurücksetzen für Benutzer:
                <strong>@Model.Username</strong>
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="ResetPassword"
                  asp-route-id="@Model.UserId"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="newPassword" class="form-label">Neues Passwort</label>
                    <input type="password"
                           name="newPassword"
                           id="newPassword"
                           class="form-control"
                           placeholder="Neues Passwort eingeben"
                           required />
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Passwort bestätigen</label>
                    <input type="password"
                           name="confirmPassword"
                           id="confirmPassword"
                           class="form-control"
                           placeholder="Neues Passwort bestätigen"
                           required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-check-circle"></i> Speichern
                    </button>

                    <a asp-action="Index" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-left"></i> Zurück
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

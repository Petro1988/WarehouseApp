@model IEnumerable<WarehouseApp.Models.Category>

@{
    ViewData["Title"] = "Kategorien";
}

<div class="container mt-4">

    <!-- 🔹 HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-tags-fill"></i> Kategorien
            </h5>

            <a asp-action="Create" class="btn btn-light btn-sm">
                <i class="bi bi-plus-circle"></i> Kategorie hinzufügen
            </a>
        </div>

        <!-- 🔍 SEARCH -->
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-7">
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Kategorie suchen..." />
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Suchen
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
                {
                    <div class="col-md-2">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle"></i> Zurücksetzen
                        </a>
                    </div>
                }

            </form>

        </div>
    </div>

    <!-- 📋 TABLE -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th class="text-center" style="width: 160px;">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle"></i>
                                Keine Kategorien gefunden
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.CategoryId"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@item.CategoryId"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

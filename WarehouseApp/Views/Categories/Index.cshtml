@model IEnumerable<WarehouseApp.Models.Category>

@{
    ViewData["Title"] = "Kategorien";
    bool isAdmin = User.IsInRole("Admin");
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-tags-fill"></i> Kategorien
            </h5>

            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i> Kategorie hinzufügen
                </a>
            }
        </div>

        <!-- SEARCH -->
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-8">
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Kategorie suchen..." />
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Suchen
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
                {
                    <div class="col-md-2">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle"></i> Zurücksetzen
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        @if (isAdmin)
                        {
                            <th class="text-center" style="width: 140px;">
                                Aktionen
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 2 : 1)"
                                class="text-center text-muted py-4">
                                <i class="bi bi-info-circle"></i>
                                Keine Kategorien gefunden
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>

                                @if (isAdmin)
                                {
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-outline-primary"
                                               title="Bearbeiten">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-outline-danger"
                                               title="Löschen">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


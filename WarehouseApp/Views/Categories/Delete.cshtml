@model WarehouseApp.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <i class="bi bi-exclamation-triangle"></i> Kategorie löschen
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                Möchten Sie diese Kategorie wirklich löschen?
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-4">Kategorie ID</dt>
                <dd class="col-sm-8">@Model.CategoryId</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Name</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="CategoryId" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-trash"></i> Löschen
                    </button>

                    <a asp-action="Index" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-left"></i> Abbrechen
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

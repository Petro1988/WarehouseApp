@model WarehouseApp.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="card shadow-sm p-4 col-md-6 mx-auto mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            <i class="bi bi-eye"></i> Category Details
        </h4>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="border rounded p-3 bg-light">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">ID:</dt>
            <dd class="col-sm-8">@Model.CategoryId</dd>

            <dt class="col-sm-4 text-muted">Name:</dt>
            <dd class="col-sm-8 fw-bold">@Model.Name</dd>
        </dl>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.CategoryId" class="btn btn-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

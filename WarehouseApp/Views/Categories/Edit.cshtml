@model WarehouseApp.Models.Category

@{
    ViewData["Title"] = "Kategorie bearbeiten";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <i class="bi bi-pencil-square"></i> Kategorie bearbeiten
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="CategoryId" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning w-100">
                        <i class="bi bi-save"></i> Aktualisieren
                    </button>

                    <a asp-action="Index" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-left"></i> Zurück
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

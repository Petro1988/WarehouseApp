@model WarehouseApp.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h2 class="text-danger"><i class="bi bi-trash"></i> Delete Product</h2>
<p class="text-muted">Are you sure you want to delete this product?</p>

<div class="card p-4 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>

        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>

        <dt class="col-sm-3">Minimum Stock</dt>
        <dd class="col-sm-9">@Model.MinimumStock</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="ProductId" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

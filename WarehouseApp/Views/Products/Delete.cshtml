@model WarehouseApp.Models.Product

@{
    ViewData["Title"] = "Artikel löschen";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">

        <!-- 🔴 HEADER -->
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                <i class="bi bi-trash"></i> Artikel löschen
            </h5>
        </div>

        <!-- ⚠️ BODY -->
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                Möchten Sie diesen Artikel wirklich dauerhaft löschen?
            </div>

            <!-- 🧾 DETAILS -->
            <dl class="row mb-4">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Kategorie</dt>
                <dd class="col-sm-8">@Model.Category?.Name</dd>

                <dt class="col-sm-4">Menge</dt>
                <dd class="col-sm-8">@Model.Quantity</dd>

                <dt class="col-sm-4">Mindestbestand</dt>
                <dd class="col-sm-8">@Model.MinimumStock</dd>
            </dl>

            <!-- 🔘 ACTIONS -->
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProductId" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-trash"></i> Löschen
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-left"></i> Abbrechen
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

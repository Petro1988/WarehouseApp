@model WarehouseApp.Models.PaginatedList<WarehouseApp.Models.Product>

@{
    ViewData["Title"] = "Products";
    var sortOrder = ViewBag.CurrentSort as string;
    var query = Context.Request.Query;
    var currentSize = ViewBag.PageSize as int? ?? 10;
}

<h2 class="mb-3">Products</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="search" class="form-control" placeholder="Search by name"
               value="@query["search"]" />
    </div>

    <div class="col-md-3">
        <select name="categoryId" class="form-select">
            <option value="">All Categories</option>
            @if (ViewData["CategoryId"] is SelectList categories)
            {
                foreach (var cat in categories)
                {
                    <option value="@cat.Value" selected="@(query["categoryId"] == cat.Value ? "selected" : null)">
                        @cat.Text
                    </option>
                }
            }
        </select>
    </div>

    <div class="col-md-2">
        <select name="pageSize" class="form-select" onchange="this.form.submit()">
            <option value="10" selected="@(currentSize == 10)">10 / page</option>
            <option value="25" selected="@(currentSize == 25)">25 / page</option>
            <option value="50" selected="@(currentSize == 50)">50 / page</option>
            <option value="100" selected="@(currentSize == 100)">100 / page</option>
        </select>
    </div>

    <div class="col-md-2">
        <a asp-action="Index"
           asp-route-sortOrder="@ViewBag.SortByStock"
           asp-route-pageSize="@currentSize"
           class="btn btn-outline-secondary w-100">
            @(ViewBag.CurrentSort == "low" ? "Show All" : "Show Low Stock First")
        </a>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Product List</h5>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add Product
    </a>
</div>

<table class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th class="text-center">Quantity</th>
            <th class="text-center">Minimum Stock</th>
            <th>Status</th>
            @if (User.IsInRole("Admin"))
            {
                <th class="text-end">Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isLow = item.MinimumStock > 0 && item.Quantity < item.MinimumStock;
            <tr class="@(isLow ? "table-warning" : "")">
                <td>@item.Name</td>
                <td>@item.Category?.Name</td>
                <td class="text-center">@item.Quantity</td>
                <td class="text-center">@item.MinimumStock</td>
                <td>
                    @if (item.MinimumStock == 0)
                    {
                        <span class="text-muted">—</span>
                    }
                    else if (isLow)
                    {
                        <span class="text-danger fw-bold" data-bs-toggle="tooltip"
                              title="Missing @(item.MinimumStock - item.Quantity)">
                            <i class="bi bi-exclamation-circle"></i> Low stock!
                        </span>
                    }
                    else
                    {
                        <span class="text-success">
                            <i class="bi bi-check-circle"></i> OK
                        </span>
                    }
                </td>
                @if (User.IsInRole("Admin"))
                {
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.ProductId"
                           class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.ProductId"
                           class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@{
    int start = Math.Max(1, Model.PageIndex - 2);
    int end = Math.Min(Model.TotalPages, Model.PageIndex + 2);
}

<nav>
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link"
               asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-pageSize="@currentSize"
               asp-route-search="@query["search"]"
               asp-route-categoryId="@query["categoryId"]"
               asp-route-sortOrder="@ViewBag.CurrentSort">
                Previous
            </a>
        </li>

        @for (var i = start; i <= end; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@i"
                   asp-route-pageSize="@currentSize"
                   asp-route-search="@query["search"]"
                   asp-route-categoryId="@query["categoryId"]"
                   asp-route-sortOrder="@ViewBag.CurrentSort">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link"
               asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-pageSize="@currentSize"
               asp-route-search="@query["search"]"
               asp-route-categoryId="@query["categoryId"]"
               asp-route-sortOrder="@ViewBag.CurrentSort">
                Next
            </a>
        </li>
    </ul>
</nav>

@section Scripts {
    <script>
        // Bootstrap tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
    </script>
}

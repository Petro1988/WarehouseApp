@model WarehouseApp.Models.PaginatedList<WarehouseApp.Models.Product>

@{
    ViewData["Title"] = "Artikel";
    var query = Context.Request.Query;
    var currentSize = ViewBag.PageSize as int? ?? 10;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="container mt-4">

    <!-- 🔹 HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-box-seam"></i> Artikel
            </h5>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i> Artikel hinzufügen
                </a>
            }
        </div>

        <!-- 🔍 FILTERS -->
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-3">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Nach Artikelname suchen"
                           value="@query["search"]" />
                </div>

                <div class="col-md-3">
                    <select name="categoryId" class="form-select">
                        <option value="">Alle Kategorien</option>
                        @if (ViewData["CategoryId"] is SelectList categories)
                        {
                            foreach (var cat in categories)
                            {
                                <option value="@cat.Value"
                                        selected="@(query["categoryId"] == cat.Value)">
                                    @cat.Text
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="pageSize" class="form-select" onchange="this.form.submit()">
                        <option value="10" selected="@(currentSize == 10)">10 pro Seite</option>
                        <option value="25" selected="@(currentSize == 25)">25 pro Seite</option>
                        <option value="50" selected="@(currentSize == 50)">50 pro Seite</option>
                        <option value="100" selected="@(currentSize == 100)">100 pro Seite</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewBag.SortByStock"
                       asp-route-pageSize="@currentSize"
                       class="btn btn-outline-secondary w-100">
                        <i class="bi bi-sort-down"></i>
                        @(ViewBag.CurrentSort == "Niedriger Bestand" ? "Alle anzeigen" : "Niedriger Bestand zuerst")
                    </a>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Filtern
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 📋 TABLE -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Kategorie</th>
                        <th class="text-center">Menge</th>
                        <th class="text-center">Mindestbestand</th>
                        <th>Status</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-end">Aktionen</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isLow = item.MinimumStock > 0 && item.Quantity < item.MinimumStock;

                        <tr class="@(isLow ? "table-warning" : "")">
                            <td>@item.Name</td>
                            <td>@item.Category?.Name</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-center">@item.MinimumStock</td>
                            <td>
                                @if (item.MinimumStock == 0)
                                {
                                    <span class="badge bg-secondary">Kein Mindestbestand</span>
                                }
                                else if (isLow)
                                {
                                    <span class="badge bg-danger"
                                          data-bs-toggle="tooltip"
                                          title="Fehlmenge: @(item.MinimumStock - item.Quantity)">
                                        <i class="bi bi-exclamation-circle"></i> Niedriger Bestand
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> OK
                                    </span>
                                }
                            </td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.ProductId"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.ProductId"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 🔢 PAGINATION -->
        <div class="card-footer">
            @{
                int start = Math.Max(1, Model.PageIndex - 2);
                int end = Math.Min(Model.TotalPages, Model.PageIndex + 2);
            }

            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-pageSize="@currentSize"
                       asp-route-search="@query["search"]"
                       asp-route-categoryId="@query["categoryId"]"
                       asp-route-sortOrder="@ViewBag.CurrentSort">
                        Zurück
                    </a>
                </li>

                @for (var i = start; i <= end; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@currentSize"
                           asp-route-search="@query["search"]"
                           asp-route-categoryId="@query["categoryId"]"
                           asp-route-sortOrder="@ViewBag.CurrentSort">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-pageSize="@currentSize"
                       asp-route-search="@query["search"]"
                       asp-route-categoryId="@query["categoryId"]"
                       asp-route-sortOrder="@ViewBag.CurrentSort">
                        Weiter
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(el => new bootstrap.Tooltip(el));
    </script>
}

@model WarehouseApp.Models.Product

@{
    ViewData["Title"] = "Artikel bearbeiten";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">

        <!-- HEADER -->
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-pencil-square"></i> Artikel bearbeiten
            </h5>
        </div>

        <!-- BODY -->
        <div class="card-body">
            <form asp-action="Edit" method="post" autocomplete="off">
                <input type="hidden" asp-for="ProductId" />

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold">
                        Kategorie
                    </label>
                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryId"
                            class="form-select">
                        <option value="">-- Kategorie auswählen --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <!-- Minimum stock -->
                <div class="mb-3">
                    <label asp-for="MinimumStock" class="form-label fw-semibold">
                        Mindestbestand
                    </label>
                    <input asp-for="MinimumStock"
                           type="number"
                           min="0"
                           class="form-control" />
                    <span asp-validation-for="MinimumStock" class="text-danger"></span>
                </div>

                <!-- Quantity (readonly) -->
                <div class="mb-4">
                    <label asp-for="Quantity" class="form-label fw-semibold">
                        Aktueller Bestand
                    </label>
                    <input asp-for="Quantity"
                           class="form-control bg-light"
                           readonly />
                </div>

                <!-- ACTIONS -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-save"></i> Aktualisieren
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-left"></i> Abbrechen
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
